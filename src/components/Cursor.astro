---
// Cursor.astro — custom dot + trailing ring. body has `cursor: none`
// (global.css), so every page must include this component.
---

<div id="cursor" aria-hidden="true"></div>
<div id="cursor-ring" aria-hidden="true"></div>

<script>
  const cursor = document.getElementById("cursor")!;
  const ring = document.getElementById("cursor-ring")!;
  let mx = 0,
    my = 0,
    rx = 0,
    ry = 0;

  document.addEventListener("mousemove", (e) => {
    mx = e.clientX;
    my = e.clientY;
    cursor.style.left = mx + "px";
    cursor.style.top = my + "px";
  });

  // The ring eases toward the pointer and the loop stops once it settles, so
  // the main thread goes idle (Lighthouse waits for that before finishing).
  let ringRaf = 0;
  function animRing() {
    rx += (mx - rx) * 0.1;
    ry += (my - ry) * 0.1;
    ring.style.left = rx + "px";
    ring.style.top = ry + "px";
    ringRaf =
      Math.abs(mx - rx) + Math.abs(my - ry) > 0.5 ? requestAnimationFrame(animRing) : 0;
  }
  document.addEventListener("mousemove", () => {
    if (!ringRaf) ringRaf = requestAnimationFrame(animRing);
  });

</script>
