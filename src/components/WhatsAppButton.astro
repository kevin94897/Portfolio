---
// WhatsAppButton.astro — floating WhatsApp link with a prefilled message in
// the page language. Tracked as contact_click {method: whatsapp,
// location: floating_button} through the data-track attributes.
import { useTranslations } from "../i18n/utils";

const locale = (Astro.currentLocale || "es") as "es" | "en";
const t = useTranslations(locale);
const PHONE = "51947841355";
const href = `https://wa.me/${PHONE}?text=${encodeURIComponent(t("wa.message"))}`;
---

<a
  id="wa-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t("wa.label")}
  data-track="contact_click"
  data-track-method="whatsapp"
  data-track-location="floating_button"
>
  <span class="wa-tip" aria-hidden="true">{t("wa.tooltip")}</span>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.45-5.03c0-5.2 4.24-9.43 9.45-9.43 2.52 0 4.89.99 6.67 2.77a9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.44-9.44 9.44m8.03-17.47A11.28 11.28 0 0 0 12.05.7C5.8.7.7 5.8.7 12.07c0 2 .52 3.95 1.52 5.67L.6 23.64l6.03-1.58a11.33 11.33 0 0 0 5.42 1.38h.01c6.26 0 11.36-5.1 11.36-11.37 0-3.04-1.18-5.89-3.33-8.04"
    ></path>
  </svg>
</a>

<style>
  #wa-float {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--lime);
    color: #000;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.25s ease;
    cursor: none;
  }
  #wa-float:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 28px var(--lime-glow);
  }
  #wa-float:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 4px;
  }
  @media (min-width: 640px) {
    #wa-float {
      right: 24px;
      bottom: 24px;
    }
  }

  .wa-tip {
    position: absolute;
    right: calc(100% + 12px);
    padding: 6px 12px;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 12px;
    white-space: nowrap;
    border-radius: 6px;
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity 0.2s,
      transform 0.2s;
    pointer-events: none;
  }
  @media (hover: hover) {
    #wa-float:hover .wa-tip {
      opacity: 1;
      transform: none;
    }
  }

  /* On phones the cookie notice spans the width — step aside while it's open. */
  @media (max-width: 639px) {
    :global(body.consent-open) #wa-float {
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #wa-float,
    .wa-tip {
      transition: none;
    }
  }
</style>
