---
import imgLiwilu from "../assets/images/portfolio/Liwilu.webp";
import imgAstra from "../assets/images/portfolio/Astramedical.webp";
import imgWisec from "../assets/images/portfolio/Aiconstruye.webp";
import imgGustos from "../assets/images/portfolio/Gustoscoffee.webp";
import imgWhaticket from "../assets/images/portfolio/whaticket.webp";
import imgChapa from "../assets/images/portfolio/Chapatubeca.webp";
import imgSegway from "../assets/images/portfolio/Segwaysports.webp";
import imgColecciones from "../assets/images/portfolio/KGFront.webp";
import imgKGStore from "../assets/images/portfolio/KGStore.webp";
import imgPuntoAzul from "../assets/images/portfolio/Puntoazul.webp";
import imgCafePlaza from "../assets/images/portfolio/CafePlaza.webp";
import imgNeoRun from "../assets/images/portfolio/NeoRun.webp";
import { useTranslations } from "../i18n/utils";

const locale = (Astro.currentLocale || "es") as "es" | "en";
const t = useTranslations(locale);

interface Project {
  img: ImageMetadata;
  category: string;
  name: string;
  descKey: string;
  desc: string;
  stack: string[];
  url: string;
  demo?: { user: string; pass: string };
}

// Pre-translate descriptions so the JSON embedded in the page is already localized
const projects: Project[] = [
  {
    img: imgNeoRun,
    category: "Interactive Game",
    name: "NEOrun",
    descKey: "p.neorun.desc",
    desc: t("p.neorun.desc"),
    stack: ["React", "Phaser 3", "Supabase", "Vite"],
    url: "https://neorun.neoingredients.com.pe/",
  },
  {
    img: imgColecciones,
    category: "SPA",
    name: "Colecciones Grupo Gómez",
    descKey: "p.colecciones.desc",
    desc: t("p.colecciones.desc"),
    stack: ["React", "React Router", "Lucide", "Vercel"],
    url: "https://colecciones.grupo-gomez.com/",
  },
  {
    img: imgLiwilu,
    category: "Headless E-Commerce",
    name: "Liwilu",
    descKey: "p.liwilu.desc",
    desc: t("p.liwilu.desc"),
    stack: ["Next.js", "NestJS", "PrestaShop", "Tailwind"],
    url: "https://liwilu-staging.vercel.app/",
  },
  {
    img: imgKGStore,
    category: "PWA",
    name: "KG Store Admin",
    descKey: "p.kgstore.desc",
    desc: t("p.kgstore.desc"),
    stack: ["React", "Supabase", "PostgreSQL", "Cloudflare"],
    url: "https://kg-admin-delta.vercel.app/",
    demo: { user: "demo", pass: "QCyJ iNW7 sFpl BPPS FoAR cka8" },
  },
  {
    img: imgCafePlaza,
    category: "Corporate",
    name: "Café de la Plaza",
    descKey: "p.cafeplaza.desc",
    desc: t("p.cafeplaza.desc"),
    stack: ["WordPress", "Elementor", "GSAP", "Kinsta"],
    url: "https://cafedelaplazapr.com/",
  },
  {
    img: imgGustos,
    category: "E-Commerce",
    name: "Gustos Coffee Co.",
    descKey: "p.gustos.desc",
    desc: t("p.gustos.desc"),
    stack: ["Shopify", "Vue.js", "Cloudflare", "Apple Pay"],
    url: "https://www.gustoscoffeeco.com/",
  },
  {
    img: imgWisec,
    category: "SSG Landing",
    name: "AIcon",
    descKey: "p.aicon.desc",
    desc: t("p.aicon.desc"),
    stack: ["Astro", "Alpine.js", "Vercel", "AWS"],
    url: "https://landing-wisec.vercel.app/",
  },
  {
    img: imgWhaticket,
    category: "SaaS",
    name: "Whaticket",
    descKey: "p.whaticket.desc",
    desc: t("p.whaticket.desc"),
    stack: ["WordPress", "Elementor", "WP Rocket", "GTM"],
    url: "https://whaticket.com/",
  },
  {
    img: imgAstra,
    category: "Corporate",
    name: "Astra Medical",
    descKey: "p.astra.desc",
    desc: t("p.astra.desc"),
    stack: ["WordPress", "WooCommerce", "PHP", "Yoast SEO"],
    url: "https://www.astra-medical.com/",
  },
  {
    img: imgChapa,
    category: "Education",
    name: "Chapa Tu Beca",
    descKey: "p.chapa.desc",
    desc: t("p.chapa.desc"),
    stack: ["WordPress Multisite", "Elementor", "PHP", "SEO"],
    url: "https://www.chapatubeca.org/",
  },
  {
    img: imgSegway,
    category: "E-Commerce",
    name: "Segway Powersports",
    descKey: "p.segway.desc",
    desc: t("p.segway.desc"),
    stack: ["WordPress", "Elementor", "RankMath", "jQuery"],
    url: "https://segwaypowersports.com.pe/",
  },
  {
    img: imgPuntoAzul,
    category: "SPA",
    name: "Panel PuntoAzul",
    descKey: "p.puntoazul.desc",
    desc: t("p.puntoazul.desc"),
    stack: ["React", "Vite", "Tailwind", "react-day-picker"],
    url: "https://staging.puntoazulrestaurante.com/",
    demo: { user: "demo", pass: "QCyJ iNW7 sFpl BPPS FoAR cka8" },
  },
];

const N = projects.length;
const viewLabel = t("p.view");

// Scroll track height: each project gets one "slice" of natural scroll, plus
// 100vh for the sticky viewport itself. No pin → scroll never freezes.
// The slice is a CSS var so mobile (flick + momentum) can use a wider one.
---

<!-- Section is pinned by ScrollTrigger; cards rotate a full turn while pinned -->
<section
  id="projects"
  class="relative w-full bg-black border-b border-border"
  aria-labelledby="projects-heading"
>
  <!-- JSON data para el script -->
  <script
    id="proj-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify(
      projects.map((p) => ({
        name: p.name,
        category: p.category,
        descKey: p.descKey,
        desc: p.desc,
        stack: p.stack,
        url: p.url,
        img: p.img.src,
        demo: p.demo ?? null,
      })),
    )}
  />

  <!-- ─── Scroll track + sticky coverflow (all breakpoints) ─── -->
  <div
    id="proj-track"
    class="relative"
    style={`--proj-count: ${N};`}
  >
    <div class="proj-sticky sticky top-[75px] w-full flex flex-col overflow-hidden">

    <!-- Header row -->
    <div id="proj-header" class="relative z-20 flex items-start justify-between px-5 sm:px-8 lg:px-[60px] pt-8 sm:pt-10 lg:pt-[89px] pb-3 max-w-[1400px] mx-auto w-full flex-shrink-0">
      <div>
        <p class="proj-eyebrow text-[10px] tracking-[0.25em] uppercase text-lime flex items-center gap-3 mb-2">
          <span>{t("proj.label")}</span>
          <span class="w-8 h-px bg-lime block" aria-hidden="true"></span>
          <span style="color:rgba(180,223,0,0.35); font-size:10px; letter-spacing:0.06em; text-transform:none;">作品集</span>
        </p>
        <h2
          id="projects-heading"
          class="section-title-anim font-display font-bold tracking-tightest leading-none text-white"
          style="font-size: clamp(1.8rem, 4.5vw, 4.5rem); font-optical-sizing: auto; font-variation-settings: 'opsz' 32;"
        >{t("proj.title")}</h2>
      </div>
      <div class="flex items-center gap-2 self-end pb-1" id="proj-nav-arrows">
        <button id="proj-prev" aria-label={t("proj.prev")} class="proj-arrow-btn">
          <i class="ph ph-arrow-left text-[16px]" aria-hidden="true"></i>
        </button>
        <button id="proj-next" aria-label={t("proj.next")} class="proj-arrow-btn">
          <i class="ph ph-arrow-right text-[16px]" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <!-- Card zone: flex-1 between header and info panel -->
    <div class="relative flex-1 min-h-0 overflow-hidden">

      <!-- Ghost background text — desktop only -->
      <div class="hidden lg:flex absolute inset-0 items-center justify-center pointer-events-none select-none z-[1]" aria-hidden="true">
        <span class="font-display font-black tracking-tightest leading-none"
          style="font-size: clamp(6rem, 18vw, 22rem); font-optical-sizing: auto; color: rgba(255,255,255,0.015);">WORKS</span>
      </div>

      <!-- Vertical Image Stack — responsive width -->
      <div
        id="proj-stack"
        class="proj-stack-size absolute z-[5]"
      >
        {
          projects.map((p, i) => (
            <div
              class="proj-card absolute inset-0 overflow-hidden"
              data-index={String(i)}
              data-active={i === 0 ? "true" : "false"}
              data-project={JSON.stringify({
                name: p.name,
                category: p.category,
                descKey: p.descKey,
                desc: p.desc,
                stack: p.stack,
                url: p.url,
                img: p.img.src,
                demo: p.demo ?? null,
              })}
              role="button"
              tabindex={i === 0 ? "0" : "-1"}
              aria-label={`${p.name} — ${p.category}`}
            >
              <img src={p.img.src} alt={p.name} class="w-full h-full object-contain" loading="lazy" draggable="false" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
            </div>
          ))
        }
      </div>

      <!-- Vertical nav dots — right side -->
      <div class="hidden sm:flex absolute right-4 lg:right-[50px] top-1/2 -translate-y-1/2 flex-col gap-[10px] z-20">
        {projects.map((_, i) => (
          <button class="proj-dot-v" data-idx={String(i)} aria-label={`${t("proj.nth")} ${i + 1}`} />
        ))}
      </div>

      <!-- Stack counter — left side -->
      <div class="hidden sm:flex absolute left-4 lg:left-[50px] top-1/2 -translate-y-1/2 flex-col items-center z-20 pointer-events-none select-none">
        <span id="stack-counter-curr" class="font-display font-light text-white tabular-nums" style="font-size:clamp(1.5rem,3vw,3rem);">01</span>
        <div class="my-2 h-px w-8 bg-white/20"></div>
        <span class="text-[13px] text-muted tabular-nums font-display">{String(N).padStart(2, "0")}</span>
      </div>

    </div><!-- /card zone -->

  <!-- Panel info inferior -->
  <div
    id="proj-info-panel"
    class="flex-shrink-0 z-10 bg-gradient-to-t from-black via-black/90 to-transparent"
  >
    <!-- Container limitado -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 pt-6 pb-7">
      <div id="proj-info-content">
        <!-- Category -->
        <p
          id="proj-info-cat"
          class="text-[10px] tracking-[0.2em] uppercase text-lime mb-2"
        >
        </p>

        <!-- Name + stack + link -->
        <div
          class="flex flex-col md:flex-row md:items-end justify-between gap-4"
        >
          <div class="flex-1 min-w-0">
            <h3
              id="proj-info-name"
              class="font-display font-semibold text-white tracking-tightest leading-none mb-2"
              style="font-size: clamp(1.2rem, 2.6vw, 2.2rem); font-optical-sizing: auto;"
            >
            </h3>
            <p
              id="proj-info-desc"
              class="text-muted text-[12px] md:text-[13px] leading-relaxed proj-desc-clamp"
            >
            </p>
          </div>
          <div
            class="flex flex-col items-start md:items-end gap-3 flex-shrink-0"
          >
            <div
              id="proj-info-stack"
              class="flex flex-wrap gap-[5px] md:justify-end"
            >
            </div>
            <a
              id="proj-info-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden md:inline-flex items-center gap-2 px-5 py-[10px] bg-lime text-black
                   text-[14px] tracking-tight uppercase font-semibold no-underline
                   transition-all duration-200 hover:opacity-90"
            >
              <span>{viewLabel}</span>
            </a>
          </div>
        </div>

        <!-- Progress -->
        <div class="flex items-center gap-4 mt-4">
          <div class="flex-1 h-px bg-border relative overflow-hidden">
            <div
              id="proj-progress-fill"
              class="absolute left-0 top-0 h-full bg-lime"
              style="width: 0%;"
            >
            </div>
          </div>
          <span
            id="proj-counter"
            class="text-[10px] tracking-widest text-muted whitespace-nowrap font-display"
          >
            01 / {String(N).padStart(2, "0")}
          </span>
        </div>
      </div>
    </div><!-- /container -->
  </div><!-- /info panel -->

  </div><!-- /sticky viewport -->
  </div><!-- /proj-track -->
</section>

<!-- Modal -->
<div
  id="proj-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  class="fixed inset-0 z-[9000] flex items-center justify-center p-4 lg:p-8
         opacity-0 invisible pointer-events-none transition-[opacity,visibility] duration-300"
>
  <div
    id="modal-backdrop"
    class="absolute inset-0 bg-black/80 backdrop-blur-[6px]"
  >
  </div>
  <div
    class="modal-panel relative w-full max-w-[680px] max-h-[90vh] overflow-y-auto
              bg-surface2 border border-border
              translate-y-[30px] transition-transform duration-300
              shadow-[0_40px_100px_rgba(0,0,0,0.7)]"
    data-lenis-prevent
    tabindex="-1"
  >
    <button
      id="modal-close"
      aria-label={t("proj.close")}
      type="button"
      class="absolute top-3 right-3 lg:top-4 lg:right-4 w-9 h-9 flex items-center justify-center
             border border-border text-muted cursor-pointer
             transition-all duration-200 hover:border-lime/30 hover:text-lime z-10"
    >
      <i class="ph ph-x text-[16px]" aria-hidden="true"></i>
    </button>
    <div class="relative h-[200px] sm:h-[280px] lg:h-[360px] overflow-hidden">
      <img
        id="modal-img"
        src=""
        alt=""
        class="w-full h-full object-cover object-top"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-surface2 via-surface2/20 to-transparent"
      >
      </div>
    </div>
    <div class="px-5 sm:px-7 lg:px-9 pb-6 lg:pb-8 -mt-4 relative">
      <p
        id="modal-category"
        class="text-[9px] tracking-[0.15em] uppercase text-lime mb-2"
      >
      </p>
      <h3
        id="modal-title"
        class="font-display text-[20px] lg:text-[28px] font-bold text-white mb-3 leading-tight"
        style="font-optical-sizing: auto;"
      >
      </h3>
      <p id="modal-desc" class="text-[13px] leading-[1.75] text-text/65 mb-5">
      </p>
      <p class="text-[9px] tracking-[0.2em] uppercase text-muted mb-3">
        {t("proj.stack")}
      </p>
      <div
        id="modal-stack"
        class="flex flex-wrap gap-[5px] lg:gap-[6px] mb-5 lg:mb-6"
      >
      </div>
      <div
        id="modal-demo"
        class="hidden mb-6 px-4 py-4 border border-lime/[0.15] bg-lime/[0.04]"
      >
        <p class="text-[9px] tracking-[0.14em] uppercase text-lime/70 mb-3">
          {t("proj.demo")}
        </p>
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-3">
            <span class="text-[9px] text-muted w-8">user</span>
            <span
              id="modal-demo-user"
              class="text-[12px] text-text/90 tracking-[0.04em]"></span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[9px] text-muted w-8">pass</span>
            <span
              id="modal-demo-pass"
              class="text-[12px] text-text/90 tracking-[0.04em] break-all"
            ></span>
          </div>
        </div>
      </div>
      <a
        id="modal-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-[8px] px-6 py-[13px] bg-lime text-black
               text-[11px] font-medium tracking-[0.1em] uppercase no-underline
               transition-all duration-200 hover:opacity-90 hover:-translate-y-0.5"
      >
        <span>{viewLabel}</span>
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div><!-- /modal -->
<style>
  /* Scroll distance allotted to each project. Mobile momentum scrolling covers
     far more distance per gesture than a wheel tick, hence the wider slice.

     Every unit here is svh, not vh: on mobile the URL bar collapsing changes
     vh mid-scroll, and with a ~1000vh track that resizes the page by hundreds
     of pixels while the user is swiping — the sticky viewport reads that as
     violent vertical shaking. svh is fixed to the *largest* UI state, so it
     never changes. The vh line above each is the fallback for old browsers. */
  #proj-track {
    --proj-slice: 45vh;
    --proj-slice: 45svh;
    height: calc(var(--proj-count) * var(--proj-slice) + 100vh);
    height: calc(var(--proj-count) * var(--proj-slice) + 100svh);
  }
  @media (max-width: 1023px) {
    #proj-track {
      --proj-slice: 85vh;
      --proj-slice: 85svh;
    }
  }

  .proj-sticky {
    height: calc(100vh - 75px);
    height: calc(100svh - 75px);
  }

  /* Card keeps the screenshots' native 1605×1215 ratio so nothing is cropped.
     Desktop: height-driven (width follows the ratio). Mobile: width-driven. */
  .proj-stack-size {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    aspect-ratio: 1605 / 1215;
    width: auto;
    max-width: calc(100vw - 40px);
    height: min(100%, clamp(200px, 46vh, 560px));
    height: min(100%, clamp(200px, 46svh, 560px));
  }
  @media (max-width: 1023px) {
    .proj-stack-size {
      width: min(560px, calc(100vw - 40px));
      height: auto;
      max-height: 100%;
    }
  }

  #projects-heading em {
    color: #b4df00;
    font-style: normal;
  }

  /* Info panel crossfade */
  #proj-info-content {
    transition: opacity 0.18s ease;
  }

  /* Stack cards */
  .proj-card {
    cursor: pointer;
    will-change: transform, opacity;
    transition: box-shadow 0.4s ease;
    /* Safari: scale tweens on a layer holding an object-fit image flicker
       without a flattened backface; preserve-3d was also invalid here since
       overflow:hidden forces the card flat anyway. */
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-tap-highlight-color: transparent;
  }
  .proj-card[data-active="false"] {
    pointer-events: none;
  }
  .proj-card[data-active="true"] {
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  /* Vertical nav dots */
  .proj-dot-v {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.22);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: height 0.3s ease, background 0.3s ease;
  }
  .proj-dot-v.active {
    height: 24px;
    background: #b4df00;
  }
  .proj-dot-v:hover:not(.active) {
    background: rgba(255, 255, 255, 0.5);
  }

  /* Description clamp */
  .proj-desc-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Progress bar transition */
  #proj-progress-fill {
    transition: width 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Nav arrows */
  .proj-arrow-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.4);
    background: transparent;
    cursor: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }
  .proj-arrow-btn:hover {
    border-color: #b4df00;
    color: #b4df00;
    background: rgba(180, 223, 0, 0.05);
  }
  .proj-arrow-btn:disabled {
    opacity: 0.2;
    pointer-events: none;
  }

  /* Scroll hint pulse */
  @keyframes proj-pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  .proj-scroll-pulse {
    animation: proj-pulse 1.6s ease-in-out infinite;
  }

  /* Mobile Embla slider */
  .mob-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.18);
    transition:
      width 0.3s ease,
      background 0.3s ease;
  }
  .mob-dot.active {
    width: 20px;
    background: #b4df00;
  }
  .mob-slide {
    cursor: pointer;
  }

  /* Drag cursor on stack */
  #proj-stack {
    cursor: grab;
  }
  #proj-stack.dragging {
    cursor: grabbing;
  }

  /* Modal */
  #proj-modal.open {
    @apply opacity-100 visible pointer-events-auto;
  }
  #proj-modal.open .modal-panel {
    @apply translate-y-0;
  }
  .modal-panel {
    /* iOS: reaching the end of the panel must not scroll the page behind */
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    outline: none;
  }

  /* Short viewports (phone landscape, small laptops): the sticky stage is
     100svh - nav, and header + info panel alone can eat all of it, leaving
     the card zone at 0px. Compact both so the card always has room. */
  @media (max-height: 760px) {
    #proj-header {
      padding-top: 2rem;
    }
  }
  @media (max-height: 560px) {
    #proj-header {
      padding-top: 0.75rem;
      padding-bottom: 0.5rem;
    }
    #proj-header .proj-eyebrow {
      display: none;
    }
    #projects-heading {
      font-size: clamp(1.4rem, 3.5vw, 2rem) !important;
    }
    .proj-arrow-btn {
      width: 32px;
      height: 32px;
    }
    #proj-info-panel > div {
      padding-top: 0.5rem;
      padding-bottom: 0.75rem;
    }
    #proj-info-desc,
    #proj-info-stack {
      display: none;
    }
    #proj-info-name {
      font-size: 1rem !important;
      margin-bottom: 0;
    }
    #proj-info-cat {
      margin-bottom: 0.25rem;
    }
    #proj-info-panel .mt-4 {
      margin-top: 0.5rem;
    }
    .proj-stack-size {
      width: auto;
      max-width: calc(100vw - 160px);
      height: min(100%, clamp(120px, 42svh, 520px));
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  /* ─── DATA & REFS ─── */
  const PROJECTS: any[] = JSON.parse(
    document.getElementById("proj-data")!.textContent || "[]",
  );
  const N = PROJECTS.length;

  const stackEl = document.getElementById("proj-stack")!;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".proj-card"));
  const infoCat = document.getElementById("proj-info-cat")!;
  const infoName = document.getElementById("proj-info-name")!;
  const infoDesc = document.getElementById("proj-info-desc")!;
  const infoStack = document.getElementById("proj-info-stack")!;
  const infoLink = document.getElementById("proj-info-link") as HTMLAnchorElement;
  const infoCont = document.getElementById("proj-info-content")!;
  const fillBar = document.getElementById("proj-progress-fill")!;
  const counter = document.getElementById("proj-counter")!;
  const stackCounterCurr = document.getElementById("stack-counter-curr");
  const dotsVert = Array.from(document.querySelectorAll<HTMLElement>(".proj-dot-v"));

  const isMobile = () => window.innerWidth < 1024;

  /* ─── STATE ─── */
  let projIdx = 0;
  let crossTimer: ReturnType<typeof setTimeout> | null = null;
  let isDragging = false;
  let dragMoved = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let touchMoved = false;

  /* ─── VERTICAL CARD POSITIONS (one card centered, next peeks from below) ─── */
  function getCardStyle(index: number) {
    let diff = index - projIdx;
    if (diff > N / 2) diff -= N;
    if (diff < -N / 2) diff += N;

    const cardH = stackEl?.offsetHeight ?? 520;
    const step = cardH + 40;
    if (diff === 0)  return { y: 0,           scale: 1,    opacity: 1,   zIndex: 5 };
    if (diff === 1)  return { y: step,         scale: 0.92, opacity: 0.5, zIndex: 4 };
    if (diff === -1) return { y: -step,        scale: 0.92, opacity: 0,   zIndex: 3 };
    return { y: diff > 0 ? step * 2 : -step * 2, scale: 0.8, opacity: 0, zIndex: 0 };
  }

  function animateCards() {
    cards.forEach((card, i) => {
      const s = getCardStyle(i);
      gsap.to(card, {
        y: s.y, scale: s.scale, opacity: s.opacity,
        zIndex: s.zIndex, duration: 0.55, ease: "power3.out", overwrite: "auto",
      });
      card.dataset.active = String(i === projIdx);
      card.setAttribute("tabindex", i === projIdx ? "0" : "-1");
    });
    dotsVert.forEach((d, i) => d.classList.toggle("active", i === projIdx));
    if (stackCounterCurr) stackCounterCurr.textContent = String(projIdx + 1).padStart(2, "0");
  }

  function initCards() {
    cards.forEach((card, i) => {
      const s = getCardStyle(i);
      gsap.set(card, { y: s.y, scale: s.scale, opacity: s.opacity, zIndex: s.zIndex });
      card.dataset.active = String(i === 0);
    });
    dotsVert.forEach((d, i) => d.classList.toggle("active", i === 0));
  }

  /* ─── PANEL UPDATE ─── */
  function buildStackBadges(container: HTMLElement, techStack: string[]) {
    container.innerHTML = "";
    techStack.forEach((t: string) => {
      const s = document.createElement("span");
      s.className = "text-[9px] tracking-widest uppercase px-[7px] py-[3px] border border-border text-muted whitespace-nowrap";
      s.textContent = t;
      container.appendChild(s);
    });
  }

  function updatePanel(idx: number, instant = false) {
    const p = PROJECTS[idx];
    const apply = () => {
      infoCat.textContent = p.category;
      infoName.textContent = p.name;
      infoDesc.textContent = p.desc;
      infoLink.href = p.url;
      buildStackBadges(infoStack, p.stack);
      fillBar.style.width = `${(((idx + 1) / N) * 100).toFixed(1)}%`;
      counter.textContent = `${String(idx + 1).padStart(2, "0")} / ${String(N).padStart(2, "0")}`;
    };

    if (instant) { infoCont.style.opacity = "1"; apply(); return; }

    infoCont.style.opacity = "0";
    if (crossTimer) clearTimeout(crossTimer);
    crossTimer = setTimeout(() => { apply(); infoCont.style.opacity = "1"; }, 160);
  }

  /* ─── SCROLL-DRIVEN COVERFLOW (sticky track, no pin → no hijack) ─── */
  const track = document.getElementById("proj-track");
  let projST: ScrollTrigger | null = null;

  if (track) {
    projST = ScrollTrigger.create({
      trigger: track,
      start: "top top",
      end: "bottom bottom",
      invalidateOnRefresh: true,
      // No snap here on purpose: a snap tween drives window scroll, which on
      // mobile fights both native momentum and Lenis and makes the section
      // judder. The wider mobile slice (see --proj-slice) is what keeps a
      // single swipe from crossing several projects.
      onUpdate(self) {
        const newIdx = Math.min(N - 1, Math.floor(self.progress * N));
        if (newIdx !== projIdx) {
          projIdx = newIdx;
          animateCards();
          updatePanel(projIdx);
        }
      },
    });
  }

  // Manual nav scrolls the page to the project's slice within the track; the
  // ScrollTrigger above then drives the visual. Scroll stays natural (no pin).
  function goToProject(idx: number) {
    const clamped = Math.max(0, Math.min(N - 1, idx));
    if (!projST) {
      if (clamped === projIdx) return;
      projIdx = clamped;
      animateCards();
      updatePanel(projIdx);
      return;
    }
    const frac = (clamped + 0.5) / N;
    const target = projST.start + frac * (projST.end - projST.start);
    const lenis = (window as any).__lenis;
    if (lenis) lenis.scrollTo(target, { duration: 0.9 });
    else window.scrollTo({ top: target, behavior: "smooth" });
  }

  /* ─── INIT ─── */
  updatePanel(0, true);
  initCards();

  /* ─── RESIZE ───
     getCardStyle() derives the stack step from the live stack height, so the
     offsets go stale when the viewport width changes. */
  let resizeRaf: number | null = null;
  let lastW = window.innerWidth;
  window.addEventListener("resize", () => {
    // Width only. Mobile fires resize on every URL-bar collapse; the layout is
    // in svh so nothing actually moved, and refreshing mid-scroll would yank
    // the scroll position. Orientation changes come through as width changes.
    if (window.innerWidth === lastW) return;
    lastW = window.innerWidth;
    if (resizeRaf) cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(() => {
      cards.forEach((card, i) => {
        const s = getCardStyle(i);
        gsap.set(card, { y: s.y, scale: s.scale, opacity: s.opacity, zIndex: s.zIndex });
      });
      ScrollTrigger.refresh();
    });
  });

  /* ─── ARROWS ─── */
  const prevBtn = document.getElementById("proj-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("proj-next") as HTMLButtonElement | null;
  prevBtn?.addEventListener("click", () => goToProject(projIdx - 1));
  nextBtn?.addEventListener("click", () => goToProject(projIdx + 1));

  /* ─── DOTS ─── */
  dotsVert.forEach((dot, i) => {
    dot.addEventListener("click", () => goToProject(i));
  });

  /* ─── DRAG on stack (vertical: drag up = next, drag down = prev) ─── */
  stackEl?.addEventListener("mousedown", (e: MouseEvent) => {
    if (isMobile()) return;
    if ((e.target as HTMLElement).closest("a, button")) return;
    isDragging = true;
    dragMoved = false;
    dragStartX = e.clientY;
    stackEl.classList.add("dragging");
    e.preventDefault();
  });

  window.addEventListener("mousemove", (e: MouseEvent) => {
    if (!isDragging) return;
    if (Math.abs(e.clientY - dragStartX) > 8) dragMoved = true;
  });

  window.addEventListener("mouseup", (e: MouseEvent) => {
    if (!isDragging) return;
    isDragging = false;
    stackEl.classList.remove("dragging");
    if (dragMoved) {
      const delta = e.clientY - dragStartX;
      if (delta < -50) goToProject(projIdx + 1);
      else if (delta > 50) goToProject(projIdx - 1);
      setTimeout(() => { dragMoved = false; }, 50);
    }
  });

  /* ─── TOUCH: a swipe that scrolls the page must not open the modal ─── */
  stackEl?.addEventListener("touchstart", (e: TouchEvent) => {
    touchMoved = false;
    dragStartX = e.touches[0].clientY;
    dragStartY = e.touches[0].clientX;
  }, { passive: true });

  stackEl?.addEventListener("touchmove", (e: TouchEvent) => {
    const t = e.touches[0];
    if (Math.abs(t.clientY - dragStartX) > 10 || Math.abs(t.clientX - dragStartY) > 10) {
      touchMoved = true;
    }
  }, { passive: true });

  /* ─── CARD CLICKS → MODAL ─── */
  cards.forEach((card) => {
    card.addEventListener("click", () => {
      if (dragMoved || touchMoved) return;
      openModal(JSON.parse(card.dataset.project!));
    });
    card.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openModal(JSON.parse(card.dataset.project!));
      }
    });
  });

  /* ─── MODAL ─── */
  const modal = document.getElementById("proj-modal")!;
  const backdrop = document.getElementById("modal-backdrop")!;
  const closeBtn = document.getElementById("modal-close")!;
  const modalImg = document.getElementById("modal-img") as HTMLImageElement;
  const modalCat = document.getElementById("modal-category")!;
  const modalTitle = document.getElementById("modal-title")!;
  const modalDesc = document.getElementById("modal-desc")!;
  const modalStack = document.getElementById("modal-stack")!;
  const modalDemo = document.getElementById("modal-demo")!;
  const modalDemoU = document.getElementById("modal-demo-user")!;
  const modalDemoP = document.getElementById("modal-demo-pass")!;
  const modalLink = document.getElementById("modal-link") as HTMLAnchorElement;
  const modalPanel = modal.querySelector<HTMLElement>(".modal-panel")!;

  let modalOpener: HTMLElement | null = null;

  function openModal(data: any) {
    modalOpener = document.activeElement as HTMLElement | null;
    modalImg.src = data.img;
    modalImg.alt = data.name;
    modalCat.textContent = data.category;
    modalTitle.textContent = data.name;
    modalDesc.textContent = data.desc;
    modalLink.href = data.url;
    modalStack.innerHTML = "";
    (data.stack as string[]).forEach((t: string) => {
      const s = document.createElement("span");
      s.className = "text-[10px] tracking-widest uppercase px-[8px] py-[4px] border border-border text-muted";
      s.textContent = t;
      modalStack.appendChild(s);
    });
    if (data.demo) {
      modalDemoU.textContent = data.demo.user;
      modalDemoP.textContent = data.demo.pass;
      modalDemo.classList.remove("hidden");
    } else {
      modalDemo.classList.add("hidden");
    }
    modal.classList.add("open");
    modalPanel.scrollTop = 0;
    document.dispatchEvent(new CustomEvent("lenis:stop"));
    // Focus once the visibility transition has actually started — in the same
    // frame the panel is still computed as hidden and refuses focus.
    requestAnimationFrame(() =>
      requestAnimationFrame(() => modalPanel.focus({ preventScroll: true })),
    );
  }

  function closeModal() {
    if (!modal.classList.contains("open")) return;
    modal.classList.remove("open");
    document.dispatchEvent(new CustomEvent("lenis:start"));
    modalOpener?.focus({ preventScroll: true });
    modalOpener = null;
  }

  closeBtn.addEventListener("click", closeModal);
  backdrop.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

</script>
